# Server-side secrets; never expose in browser code or commit populated .env files.
TAVILY_API_KEY=
NEBIUS_API_KEY=
# Optional NVIDIA open-model ID available on your Token Factory account.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
PORT=3000
# Optional synthetic-only single-process durable state. For public hosting use a persistent volume.
DATA_FILE=./data/demo-state.json
RATE_LIMIT=120
LIVE_RATE_LIMIT=10
